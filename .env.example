# Copie para .env e preencha. O .env está no .gitignore — nunca versione.

# ---------------------------------------------------------------------------
# Asaas — https://www.asaas.com/customerApiAccessToken/index
# ---------------------------------------------------------------------------
# Crie a chave com o MÍNIMO de permissão: leitura de clientes e de cobranças.
# Se for anexar o PDF na fatura (ANEXAR_NA_COBRANCA=true), cobranças precisa
# de escrita. Nunca habilite saque/transferência via API nesta chave.
ASAAS_API_KEY=

# Produção: https://api.asaas.com/v3 — Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3

# ---------------------------------------------------------------------------
# Google (envio pelo Gmail) — https://console.cloud.google.com/
# ---------------------------------------------------------------------------
# Credencial OAuth do tipo "App para computador" (Desktop app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Quem emite
# ---------------------------------------------------------------------------
# CNPJ do prestador (só dígitos). Nota de outro emitente é recusada.
CNPJ_EMITENTE=

# Assinatura no fim do e-mail (use \n para quebrar linha).
ASSINATURA=Att\nFinanceiro

# ---------------------------------------------------------------------------
# Destinatários — escolha UMA das duas formas
# ---------------------------------------------------------------------------
# a) arquivo local: copie destinatarios.exemplo.csv para destinatarios.csv
DESTINATARIOS_CSV=destinatarios.csv

# b) Google Sheets: ID da planilha e gid da aba (ambos saem da URL).
#    Se preencher, tem prioridade sobre o CSV.
PLANILHA_ID=
PLANILHA_GID=0

# ---------------------------------------------------------------------------
# Opcional
# ---------------------------------------------------------------------------
# Anexar o PDF também na cobrança do Asaas (aparece na fatura do cliente).
ANEXAR_NA_COBRANCA=false
